# LLM 配置（OpenAI 兼容接口）——真实运行必填
# 注意：真实密钥只放在 .env（已被 .gitignore 排除），本文件只放占位符
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=your-model-name

# 业务数据库（SQLite）
DATABASE_URL=sqlite:///./data/ecom.db

# 向量库目录
VECTOR_DB_PATH=./data/vector_store

# Embedding（企业知识检索向量化）：推荐硅基流动（免费）BAAI/bge-m3；
# 不配置则回落词频向量（离线可用）
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 知识库文档目录
KNOWLEDGE_DIR=./knowledge

# 服务端口
API_HOST=0.0.0.0
API_PORT=8000

# LangSmith 可观测性（可选：注册 smith.langchain.com 拿 Key，填上即自动生效）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx
# LANGSMITH_PROJECT=ecom-service-agent

# 说明：
# - 真实运行必须配置 LLM_API_KEY，否则 create_llm 会报错
# - 单元测试使用 ScriptedStubLLM，不依赖真实 LLM
# - 业务数据由 Mock Console / seed 初始化写入 Business DB
